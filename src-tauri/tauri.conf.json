{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daily Darts Drill",
  "version": "../package.json",
  "identifier": "dev.darttrainer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "D³ – Daily Darts Drill",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2QTRDNUM5OUEyNjhGMkIKUldRcmp5YWF5Y1dreGp6R21xOWZqVHZweEpOZzFDTTdvdlQ2SnozdWZ1UkdMb285Vi8yNG9QazcK",
      "endpoints": [
        "https://github.com/sbforge/daily-darts-drill/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
